# Local development. `npx convex dev` writes CONVEX_DEPLOYMENT, VITE_CONVEX_URL and
# VITE_CONVEX_SITE_URL to .env.local by itself; nothing here needs copying for the app to run.
#
# Secrets (JWT keys, ALLOWED_EMAILS, VAPID keys) live in Convex environment variables,
# never in this file and never with a VITE_ prefix. See docs/ARCHITECTURE.md, section 12.

# The local dev deployment allows exactly this address to sign up:
#   npx convex env set ALLOWED_EMAILS dev@intent.test
# Throwaway account for trying sign-in against the local dev deployment only.
# It does not exist anywhere else. Never put a real password here.
DEV_TEST_EMAIL=dev@intent.test
DEV_TEST_PASSWORD=intent-local-dev-1
