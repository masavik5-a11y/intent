# Local development. `npx convex dev` (or `npx convex deployment select <name>`) writes
# CONVEX_DEPLOYMENT, VITE_CONVEX_URL and VITE_CONVEX_SITE_URL to .env.local by itself;
# nothing here needs copying for the app to run. Which deployments exist is recorded in
# docs/ARCHITECTURE.md, section 14.
#
# Secrets (JWT keys, ALLOWED_EMAILS, VAPID keys, deploy keys) live in Convex or Vercel
# environment variables, never in this file and never with a VITE_ prefix.

# Throwaway account for trying sign-in during development. The dev deployment's
# ALLOWED_EMAILS includes this address. On the cloud dev deployment the account does
# not exist yet: use "Create the account" once. Never put a real password here.
DEV_TEST_EMAIL=dev@intent.test
DEV_TEST_PASSWORD=intent-local-dev-1
